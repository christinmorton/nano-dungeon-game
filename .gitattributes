# Normalise line endings so the repo stays stable across machines.
* text=auto

# Always LF for shell scripts, whatever the checkout platform.
*.sh text eol=lf

# Treat these as binary — never diff, never munge line endings.
# (They are gitignored, but this keeps things correct if one is ever forced in.)
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.aseprite binary

# Machine-written catalogs: collapse them in diffs and keep them out of the
# language statistics. They are generated by scripts/build_*_reference.mjs.
src/data/tileReference*.json linguist-generated=true
package-lock.json linguist-generated=true

# Vite's lockfile and config shouldn't drive the repo's detected language.
vite.config.js linguist-vendored=true
